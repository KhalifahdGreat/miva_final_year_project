# =========================================================================
# SME Chatbot — Environment Variables
# Copy to .env and fill in. Never commit .env.
# =========================================================================

# Application
APP_ENV=development                  # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database (Postgres)
# Local dev:  the docker-compose stack maps host 5433 -> container 5432.
#             Its default user/password are both "postgres" (see docker-compose.yml),
#             so for local dev set: postgresql://postgres:postgres@localhost:5433/sme_chatbot
# Production: replace with Render's External Database URL.
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/sme_chatbot
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Redis (cache + job queue)
# Local dev:  the docker-compose stack maps host 6380 -> container 6379
# Production: replace with Render's Redis URL.
REDIS_URL=redis://localhost:6380/0

# Vector store (engine.RetrievalService)
#   Local dev  : file-backed Milvus Lite. Path is relative to the project root.
#   Production : leave the path and set MILVUS_URI + MILVUS_TOKEN below
#                (managed Milvus / Zilliz Cloud), which take precedence so the
#                web + worker services share one networked vector store.
OFOFO_VECTOR_DB_PATH=data/vectors.db
OFOFO_EMBEDDING_MODEL=all-MiniLM-L6-v2
MILVUS_URI=
MILVUS_TOKEN=

# LLM provider (Groq + Llama 3.3 70B)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=3

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-string
WHATSAPP_APP_SECRET=                 # for X-Hub-Signature-256 verification
META_GRAPH_API_BASE=https://graph.facebook.com/v20.0

# Web widget
WIDGET_ALLOWED_ORIGINS=http://localhost:3000

# Object storage (Cloudflare R2 — S3-compatible)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sme-chatbot-uploads

# Observability (all optional in dev)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# Auth (Clerk) — only needed in the Next.js dashboard, not the backend
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
